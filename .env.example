# Optional. You can set these here, or just paste them into the panel's Setup screen.
# Values entered in the panel are stored in data/config.json and take priority.

# Long-life Nitrado API token (https://server.nitrado.net -> User -> API / Token)
NITRADO_TOKEN=

# The Nitrado service ID of your Valheim server. Leave blank to pick it in the panel.
NITRADO_SERVICE_ID=

# Port the panel listens on (http://localhost:PORT)
PORT=8420

# Bind address. 127.0.0.1 keeps the panel private to this PC.
HOST=127.0.0.1

# Where the saved token lives. Defaults to ./data/config.json next to the project.
# You normally do not need to change this.
# NITRADO_DATA_DIR=C:\path\to\somewhere
