{
  "name": "valheim-nitrado-panel",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Local web control panel for a Valheim dedicated server hosted on Nitrado.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "panel": "node tools/launch.mjs",
    "stop": "node tools/stop.mjs",
    "icon": "node tools/make-icon.mjs",
    "mock": "node test/mock-nitrado.mjs",
    "discover": "node test/discover.mjs",
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiwicro/valheim-nitrado-panel.git"
  },
  "homepage": "https://github.com/kiwicro/valheim-nitrado-panel#readme",
  "bugs": {
    "url": "https://github.com/kiwicro/valheim-nitrado-panel/issues"
  },
  "author": "kiwicro",
  "keywords": [
    "valheim",
    "nitrado",
    "control-panel",
    "game-server",
    "dedicated-server",
    "bepinex"
  ],
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
